<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ca.arc7freedom.upgrader"
    android:versionCode="191"
    android:versionName="1.9.1">

    <uses-sdk
        android:minSdkVersion="15"
        android:targetSdkVersion="17" />

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="Upgrade Kobo v1.9.1"
        android:theme="@android:style/Theme.Holo.NoActionBar">

        <activity
            android:name="ca.arc7freedom.upgrader.UpgraderActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:taskAffinity="ca.arc7freedom.upgrader.main">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
