<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone `Podcasts` app (`ca.arc7freedom.podcasts`) — generated by `scripts/gen-split-apps.py`.

  A REAL, separately installable Android application: its own package id, its own launcher
  icon/label, its own task stack, its own data directory and its own row in
  Settings -> Apps, so it can be installed, updated and uninstalled on its own.

  Java classes are shared with the `Arc7 Freedom` suite (`ca.arc7freedom.app.*`), exactly
  like the `YouTube` / `YouTube Music` apps. Each APK runs under its OWN Android UID,
  with its OWN network engine/ports and only its own permissions and support components.
  Do not edit by hand — re-run `python3 scripts/gen-split-apps.py`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ca.arc7freedom.podcasts"
    android:versionCode="268"
    android:versionName="2.6.8"
    android:installLocation="internalOnly">

    <uses-sdk android:minSdkVersion="15" android:targetSdkVersion="17" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name="ca.arc7freedom.app.Arc7Application"
        android:taskAffinity="ca.arc7freedom.podcasts.task.main"
        android:icon="@drawable/ic_podcasts"
        android:label="Podcasts"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Holo">

        <activity android:name="ca.arc7freedom.support.SupportActivity" android:label="App tools" android:taskAffinity="ca.arc7freedom.podcasts.task.support" android:exported="true" />

        <activity
            android:name="ca.arc7freedom.app.Arc7PodcastsActivity"
            android:label="Podcasts"
            android:icon="@drawable/ic_podcasts"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.podcasts.task.main"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="ca.arc7freedom.app.Arc7AudioService"
            android:exported="false" />

        <service
            android:name="ca.arc7freedom.app.Arc7TlsGatewayService"
            android:exported="false" />

        <activity
            android:name="ca.arc7freedom.app.Arc7PlaybackDiagnosticsActivity"
            android:label="Playback diagnostics"
            android:taskAffinity="ca.arc7freedom.podcasts.task.arc7playbackdiagnosticsactivity"
            android:exported="false" />

        <receiver
            android:name="ca.arc7freedom.app.Arc7MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
