<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone `Weather` app (`ca.arc7freedom.weather`) — generated by `scripts/gen-split-apps.py`.

  A REAL, separately installable Android application: its own package id, its own launcher
  icon/label, its own task stack, its own data directory and its own row in
  Settings -> Apps, so it can be installed, updated and uninstalled on its own.

  Java classes are shared with the `Arc7 Freedom` suite (`ca.arc7freedom.app.*`), exactly
  like the `YouTube` / `YouTube Music` apps. Each APK runs under its OWN Android UID,
  with its OWN network engine/ports and only its own permissions and support components.
  Do not edit by hand — re-run `python3 scripts/gen-split-apps.py`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ca.arc7freedom.weather"
    android:versionCode="270"
    android:versionName="2.7.0"
    android:installLocation="internalOnly">

    <uses-sdk android:minSdkVersion="15" android:targetSdkVersion="17" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <permission android:name="ca.arc7freedom.permission.WEATHER_WIDGET" android:protectionLevel="signature" />
    <uses-permission android:name="ca.arc7freedom.permission.WEATHER_WIDGET" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location.network" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name="ca.arc7freedom.app.Arc7Application"
        android:taskAffinity="ca.arc7freedom.weather.task.main"
        android:icon="@drawable/ic_weather"
        android:label="Weather"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Holo">

        <activity android:name="ca.arc7freedom.support.SupportActivity" android:label="App tools" android:taskAffinity="ca.arc7freedom.weather.task.support" android:exported="true" />

        <activity
            android:name="ca.arc7freedom.app.Arc7WeatherActivity"
            android:label="Weather"
            android:icon="@drawable/ic_weather"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.weather.task.main"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="ca.arc7freedom.app.Arc7WeatherWidgetProvider"
            android:label="Live Weather"
            android:icon="@drawable/ic_weather"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_arc7_weather_info" />
        </receiver>

        <receiver
            android:name="ca.arc7freedom.app.Arc7WeatherBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <service
            android:name="ca.arc7freedom.app.Arc7WeatherService"
            android:exported="false" />

        <provider
            android:name="ca.arc7freedom.app.Arc7WeatherWidgetBridge"
            android:authorities="ca.arc7freedom.weather.widget"
            android:exported="true"
            android:readPermission="ca.arc7freedom.permission.WEATHER_WIDGET"
            android:writePermission="ca.arc7freedom.permission.WEATHER_WIDGET" />

        <receiver
            android:name="ca.arc7freedom.app.Arc7WeatherWidgetRequestReceiver"
            android:exported="true"
            android:permission="ca.arc7freedom.permission.WEATHER_WIDGET" />

        <service
            android:name="ca.arc7freedom.app.Arc7TlsGatewayService"
            android:exported="false" />

    </application>
</manifest>
