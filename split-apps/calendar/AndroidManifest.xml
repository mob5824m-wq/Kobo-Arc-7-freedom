<?xml version="1.0" encoding="utf-8"?>
<!--
  Standalone `Calendar` app (`ca.arc7freedom.calendar`) — generated by `scripts/gen-split-apps.py`.

  A REAL, separately installable Android application: its own package id, its own launcher
  icon/label, its own task stack, its own data directory and its own row in
  Settings -> Apps, so it can be installed, updated and uninstalled on its own.

  Java classes are shared with the `Arc7 Freedom` suite (`ca.arc7freedom.app.*`), exactly
  like the `YouTube` / `YouTube Music` apps. Each APK runs under its OWN Android UID,
  with its OWN network engine/ports and only its own permissions and support components.
  Do not edit by hand — re-run `python3 scripts/gen-split-apps.py`.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ca.arc7freedom.calendar"
    android:versionCode="265"
    android:versionName="2.6.5"
    android:installLocation="internalOnly">

    <uses-sdk android:minSdkVersion="15" android:targetSdkVersion="17" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name="ca.arc7freedom.app.Arc7Application"
        android:taskAffinity="ca.arc7freedom.calendar.task.main"
        android:icon="@drawable/ic_calendar"
        android:label="Calendar"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Holo">

        <activity
            android:name="ca.arc7freedom.app.Arc7CalendarActivity"
            android:label="Calendar"
            android:icon="@drawable/ic_calendar"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.calendar.task.main"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
            </intent-filter>
        </activity>

        <activity
            android:name="ca.arc7freedom.app.Arc7AlarmAlertActivity"
            android:label="Alarm"
            android:icon="@drawable/ic_clock"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.calendar.task.arc7alarmalertactivity"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen"
            android:exported="false" />

        <receiver
            android:name="ca.arc7freedom.app.Arc7AlarmReceiver"
            android:exported="false" />

        <receiver
            android:name="ca.arc7freedom.app.Arc7ScheduleBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="ca.arc7freedom.app.Arc7CalendarWidgetProvider"
            android:label="Calendar &amp; Agenda"
            android:icon="@drawable/ic_calendar"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_arc7_calendar_info" />
        </receiver>

        <service
            android:name="ca.arc7freedom.app.Arc7TlsGatewayService"
            android:exported="false" />

    </application>
</manifest>
