<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_media_root"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FF111827"
    android:paddingLeft="8dp"
    android:paddingRight="6dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <ImageView
        android:id="@+id/notif_media_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_audio" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingRight="6dp">

        <TextView
            android:id="@+id/notif_media_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FFF8FAFC"
            android:textStyle="bold"
            android:textSize="14sp"
            android:text="Now Playing" />

        <TextView
            android:id="@+id/notif_media_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="#FF94A3B8"
            android:textSize="12sp"
            android:text="Music" />
    </LinearLayout>

    <TextView
        android:id="@+id/notif_btn_prev"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="&#x23EE;"
        android:textColor="#FFE2E8F0"
        android:textSize="16sp"
        android:background="@android:drawable/list_selector_background" />

    <TextView
        android:id="@+id/notif_btn_toggle"
        android:layout_width="42dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="&#x23F8;"
        android:textColor="#FF38BDF8"
        android:textStyle="bold"
        android:textSize="18sp"
        android:background="@android:drawable/list_selector_background" />

    <TextView
        android:id="@+id/notif_btn_next"
        android:layout_width="38dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="&#x23ED;"
        android:textColor="#FFE2E8F0"
        android:textSize="16sp"
        android:background="@android:drawable/list_selector_background" />

    <TextView
        android:id="@+id/notif_btn_close"
        android:layout_width="34dp"
        android:layout_height="44dp"
        android:gravity="center"
        android:text="&#x2715;"
        android:textColor="#FFF87171"
        android:textSize="14sp"
        android:background="@android:drawable/list_selector_background" />
</LinearLayout>
