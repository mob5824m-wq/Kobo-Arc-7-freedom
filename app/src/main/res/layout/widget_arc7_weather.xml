<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/weather_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#F0101B2B"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="82dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#FF0369A1"
        android:padding="6dp">
        <TextView
            android:id="@+id/weather_widget_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u2014"
            android:textColor="#FFFFFFFF"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weather_widget_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="NO DATA"
            android:textColor="#FFE0F2FE"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="10dp">
        <TextView
            android:id="@+id/weather_widget_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WEATHER"
            android:textColor="#FF7DD3FC"
            android:textSize="13sp"
            android:maxLines="2"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/weather_widget_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="3dp"
            android:text="Tap to set up your forecast"
            android:textColor="#FFF8FAFC"
            android:textSize="12sp"
            android:maxLines="3" />
        <TextView
            android:id="@+id/weather_widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:text="Not updated"
            android:textColor="#FFCBD5E1"
            android:textSize="10sp"
            android:maxLines="2" />
    </LinearLayout>
    <TextView
        android:id="@+id/weather_widget_refresh"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:minHeight="48dp"
        android:gravity="center"
        android:text="Refresh"
        android:contentDescription="Refresh weather for selected city"
        android:textColor="#FF7DD3FC"
        android:textSize="11sp" />
</LinearLayout>
