<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ca.arc7freedom.app"
    android:versionCode="130"
    android:versionName="1.3.0">

    <uses-sdk
        android:minSdkVersion="15"
        android:targetSdkVersion="17" />

    <!-- Network socket permissions required by Linux/Android AID_INET guard & TLS 1.3 engine -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Storage permissions for internal eMMC (/sdcard) and external microSD (/storage/sdcard1) OS backups, books & ROM zips -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- System settings, night reading screen filter overlay & reboot self-heal -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Holo.NoActionBar">

        <!-- Main Root + 2026 CAs + System TLS 1.3 Proxy + OS Backup + Stock Android 4 + Optimizer Suite -->
        <activity
            android:name="ca.arc7freedom.app.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Standalone Modern TLS 1.3 + 2026 CA Web Browser & ROM/APK Download Manager -->
        <activity
            android:name="ca.arc7freedom.app.Arc7BrowserActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="Arc7 Browser (TLS 1.3)"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- Standalone Offline EPUB / TXT / HTML E-Book Reader (Replaces bricked Kobo Reader) -->
        <activity
            android:name="ca.arc7freedom.app.Arc7EbookReaderActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="Arc7 E-Reader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.txt" />
            </intent-filter>
        </activity>

        <!-- Standalone Interactive Root (#) & Linux Shell Terminal -->
        <activity
            android:name="ca.arc7freedom.app.Arc7TerminalActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="Arc7 Terminal"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Non-touch-blocking Warm Amber / Sepia / Extra-Dim Night Reading Overlay Service -->
        <service
            android:name="ca.arc7freedom.app.NightFilterService"
            android:exported="false" />

        <!-- Automatic Clock Self-Heal, MicroSD Auto-Remount & TLS Gateway Receiver on Boot -->
        <receiver
            android:name="ca.arc7freedom.app.BootNetworkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
