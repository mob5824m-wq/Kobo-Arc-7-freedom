<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ca.arc7freedom.app"
    android:versionCode="140"
    android:versionName="1.4.0">

    <uses-sdk
        android:minSdkVersion="15"
        android:targetSdkVersion="17" />

    <!-- Network socket permissions required by Linux/Android AID_INET guard, Wi-Fi Drive & TLS 1.3 engine -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Storage permissions for internal eMMC (/sdcard) and external microSD (/storage/sdcard1) OS backups, books, comics, music & ROM zips -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- System settings, floating soft-buttons, warm night screen filter, background audio wake lock & reboot self-heal -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Holo.NoActionBar">

        <!-- 1. Main Root + 2026 CAs + System TLS 1.3 Proxy + OS Backup + Stock Android 4 + All-in-One Power Suite -->
        <activity
            android:name="ca.arc7freedom.app.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Standalone Modern TLS 1.3 + 2026 CA + 2026 Reader Lite Web Browser -->
        <activity
            android:name="ca.arc7freedom.app.Arc7BrowserActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="Arc7 Browser (TLS 1.3)"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- 3. Standalone Offline EPUB / TXT / HTML + 70,000-Book Free Store + Color .CBZ Comic Reader -->
        <activity
            android:name="ca.arc7freedom.app.Arc7EbookReaderActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="Arc7 E-Reader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.cbz" />
                <data android:pathPattern=".*\\.txt" />
            </intent-filter>
        </activity>

        <!-- 4. Standalone Background Screen-Off Music & Audiobook Player (Auto-Bookmark + Sleep Timer) -->
        <activity
            android:name="ca.arc7freedom.app.Arc7AudioPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="Arc7 Audio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\.flac" />
            </intent-filter>
        </activity>

        <!-- 5. Standalone Smart Desk Clock, Live TLS 1.3 Weather & MicroSD Photo Frame -->
        <activity
            android:name="ca.arc7freedom.app.Arc7DeskClockActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="Arc7 Desk Clock">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 6. Standalone Root App Manager, Bloatware Freezer & APK Backup Extractor -->
        <activity
            android:name="ca.arc7freedom.app.Arc7AppManagerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="Arc7 App Manager"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 7. Standalone Interactive Root (#) & Linux Shell Terminal -->
        <activity
            android:name="ca.arc7freedom.app.Arc7TerminalActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:label="Arc7 Terminal"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Background Services -->
        <service
            android:name="ca.arc7freedom.app.NightFilterService"
            android:exported="false" />
        <service
            android:name="ca.arc7freedom.app.Arc7WifiDriveService"
            android:exported="false" />
        <service
            android:name="ca.arc7freedom.app.SoftKeysOverlayService"
            android:exported="false" />
        <service
            android:name="ca.arc7freedom.app.Arc7AudioService"
            android:exported="false" />

        <!-- Automatic Clock Self-Heal, MicroSD Auto-Remount & TLS Gateway Receiver on Boot -->
        <receiver
            android:name="ca.arc7freedom.app.BootNetworkReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
