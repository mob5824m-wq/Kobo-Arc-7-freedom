<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ca.arc7freedom.app"
    android:versionCode="200"
    android:versionName="2.0.0"
    android:installLocation="internalOnly">

    <!-- Compatible across ALL Kobo Arc models: Android 4.0.3 (API 15) through Android 4.2.2 (API 17+) -->
    <uses-sdk
        android:minSdkVersion="15"
        android:targetSdkVersion="17" />

    <!-- Optional hardware declarations so Kobo Arc 7 (front-camera-only) & Arc 7HD install cleanly -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Network, Chromebook Wired USB, Wi-Fi Drive, CA Certs & Atomic NTP Clock Sync -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Storage, Camera, HD Video Audio, Wallpapers, Alarms & Boot -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.SET_TIME_ZONE" />
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />

    <application
        android:icon="@drawable/ic_launcher"
        android:label="Kobo Arc 7 Freedom"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="true"
        android:theme="@android:style/Theme.Holo">

        <!-- 1. Main Kobo Arc 7 Freedom OS / Custom Skin / Root / Backup / Wi-Fi Suite (OWN TASK!) -->
        <activity
            android:name=".MainActivity"
            android:label="Kobo Arc 7 Freedom"
            android:icon="@drawable/ic_launcher"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.main"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Standalone Modern TLS 1.3 + 2026 CA Web Browser (`Arc7 Browser` — OWN TASK!) -->
        <activity
            android:name=".Arc7BrowserActivity"
            android:label="Arc7 Browser"
            android:icon="@drawable/ic_browser"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.browser"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- 3. Standalone Offline EPUB / CBZ / TXT E-Book Reader + 70k Gutenberg Store (`Arc7 E-Reader` — OWN TASK!) -->
        <activity
            android:name=".Arc7EbookReaderActivity"
            android:label="Arc7 E-Reader"
            android:icon="@drawable/ic_ereader"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.ereader"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.cbz" />
                <data android:pathPattern=".*\\.txt" />
            </intent-filter>
        </activity>

        <!-- 4. Standalone Screen-Off Music & Audiobook Player (`Arc7 Audio` — OWN TASK!) -->
        <activity
            android:name=".Arc7AudioPlayerActivity"
            android:label="Arc7 Audio"
            android:icon="@drawable/ic_audio"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.audio"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- 5. Standalone `Arc7 Clock` (Internet Archive Chimes, World Clock, Timer, Stopwatch — OWN TASK!) -->
        <activity
            android:name=".Arc7ClockActivity"
            android:label="Arc7 Clock"
            android:icon="@drawable/ic_clock"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.clock"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 6. Nightstand Split-Flap Flip Clock & Weather Station (OWN TASK!) -->
        <activity
            android:name=".Arc7DeskClockActivity"
            android:label="Arc7 Nightstand"
            android:icon="@drawable/ic_clock"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.nightstand"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen"
            android:exported="true" />

        <!-- 7. Full-Screen Wake-Screen Alarm & Calendar Alert (Dismiss / Snooze — OWN TASK!) -->
        <activity
            android:name=".Arc7AlarmAlertActivity"
            android:label="Arc7 Alarm"
            android:icon="@drawable/ic_clock"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.alarm"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Holo.NoActionBar.Fullscreen"
            android:exported="true" />

        <!-- 8. Standalone `Arc7 Wallpapers` HD Picker (OWN TASK!) -->
        <activity
            android:name=".Arc7WallpaperPickerActivity"
            android:label="Arc7 Wallpapers"
            android:icon="@drawable/ic_wallpaper"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.wallpaper"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 9. Standalone `Arc7 App Manager` (OWN TASK!) -->
        <activity
            android:name=".Arc7AppManagerActivity"
            android:label="Arc7 App Manager"
            android:icon="@drawable/ic_appmgr"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.appmgr"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 10. Standalone `Arc7 Terminal` Root/Shell Emulator (OWN TASK!) -->
        <activity
            android:name=".Arc7TerminalActivity"
            android:label="Arc7 Terminal"
            android:icon="@drawable/ic_terminal"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.terminal"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 11. NEW `Arc7 Calendar` App (Month + Agenda + Reminders + .ics Sync — OWN TASK!) -->
        <activity
            android:name=".Arc7CalendarActivity"
            android:label="Arc7 Calendar"
            android:icon="@drawable/ic_calendar"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.calendar"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
            </intent-filter>
        </activity>

        <!-- 12. NEW `Arc7 Photos` Gallery & Photo Filter Studio (OWN TASK!) -->
        <activity
            android:name=".Arc7PhotosActivity"
            android:label="Arc7 Photos"
            android:icon="@drawable/ic_photos"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.photos"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <!-- 13. NEW `Arc7 Camera` HD Photo & Video Studio with Front Screen Flash (OWN TASK!) -->
        <activity
            android:name=".Arc7CameraActivity"
            android:label="Arc7 Camera"
            android:icon="@drawable/ic_camera"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.camera"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.media.action.IMAGE_CAPTURE" />
                <action android:name="android.media.action.VIDEO_CAPTURE" />
                <action android:name="android.media.action.STILL_IMAGE_CAMERA" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 14. NEW `Arc7 Calculator` Scientific Calculator & Unit Converter (OWN TASK!) -->
        <activity
            android:name=".Arc7CalculatorActivity"
            android:label="Arc7 Calculator"
            android:icon="@drawable/ic_calculator"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.calc"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 15. NEW `Arc7 Notes` Notes, Checklists & Color Sketchpad (OWN TASK!) -->
        <activity
            android:name=".Arc7NotesActivity"
            android:label="Arc7 Notes"
            android:icon="@drawable/ic_notes"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.notes"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 16. NEW `Arc7 Files` Internal, MicroSD & ZIP Explorer (OWN TASK!) -->
        <activity
            android:name=".Arc7FileManagerActivity"
            android:label="Arc7 Files"
            android:icon="@drawable/ic_files"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.files"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 17. NEW `Chromebook USB Net` Two-Way Wired Internet Control Center (OWN TASK!) -->
        <activity
            android:name=".Arc7WiredInternetActivity"
            android:label="Chromebook USB Net"
            android:icon="@drawable/ic_wired_net"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.usbnet"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 18. NEW Custom `Arc7 APK Installer` (Manifest Audit + Auto JAR v1 Signer + Fast Root Install!) -->
        <activity
            android:name=".Arc7PackageInstallerActivity"
            android:label="Arc7 APK Installer"
            android:icon="@drawable/ic_apk_installer"
            android:launchMode="singleTask"
            android:taskAffinity="ca.arc7freedom.task.apkinstaller"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.INSTALL_PACKAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/vnd.android.package-archive" />
            </intent-filter>
        </activity>

        <!-- Persistent Background Services -->
        <service android:name=".Arc7TlsGatewayService" android:exported="true" />
        <service android:name=".Arc7ChromebookUsbService" android:exported="true" />
        <service android:name=".Arc7AdbBackupService" android:exported="true" />
        <service android:name=".NightFilterService" android:exported="false" />
        <service android:name=".Arc7WifiDriveService" android:exported="false" />
        <service android:name=".SoftKeysOverlayService" android:exported="false" />
        <service android:name=".Arc7AudioService" android:exported="true" />

        <!-- Built-in Home Screen Widgets (Android 4.2+ AppWidgetProviders) -->
        <receiver
            android:name=".Arc7ClockWidgetProvider"
            android:label="Arc7 Digital Clock &amp; Alarm"
            android:icon="@drawable/ic_clock"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc7_clock_info" />
        </receiver>

        <receiver
            android:name=".Arc7CalendarWidgetProvider"
            android:label="Arc7 Calendar &amp; Upcoming Agenda"
            android:icon="@drawable/ic_calendar"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc7_calendar_info" />
        </receiver>

        <receiver
            android:name=".Arc7AudioWidgetProvider"
            android:label="Arc7 Audio &amp; Audiobook Player"
            android:icon="@drawable/ic_audio"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc7_audio_info" />
        </receiver>

        <receiver
            android:name=".Arc7PowerWidgetProvider"
            android:label="Arc7 Quick Dock &amp; TLS 1.3 Status"
            android:icon="@drawable/ic_launcher"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_arc7_power_info" />
        </receiver>

        <!-- Boot / Wi-Fi / Self-Upgrade Receiver -->
        <receiver android:name=".BootNetworkReceiver" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

        <!-- Scheduled Alarm & Calendar Trigger Receiver -->
        <receiver android:name=".Arc7AlarmReceiver" android:exported="true" />

    </application>
</manifest>
