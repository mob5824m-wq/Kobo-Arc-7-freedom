<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ca.arc7freedom.app"
    android:versionCode="170"
    android:versionName="1.7.0">

    <uses-sdk
        android:minSdkVersion="15"
        android:targetSdkVersion="17" />

    <!-- Network socket permissions required by Linux/Android AID_INET guard, Wi-Fi Drive & TLS 1.3 engine -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- Storage permissions for internal eMMC (/sdcard) and external microSD (/storage/sdcard1) OS backups, books, comics, music, photos & ROM zips -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- Wallpaper, alarm chime stream control, floating soft-buttons, warm night screen filter, background audio wake lock & reboot self-heal -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.DISABLE_KEYGUARD" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:theme="@android:style/Theme.Holo.NoActionBar">

        <!-- 1. Main Root + 2026 CAs + System TLS 1.3 Proxy + OS Backup + Stock Android 4 + All-in-One Power Suite -->
        <activity
            android:name="ca.arc7freedom.app.MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:icon="@drawable/ic_launcher"
            android:label="@string/app_name"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Standalone Modern TLS 1.3 + 2026 CA Web Browser -->
        <activity
            android:name="ca.arc7freedom.app.Arc7BrowserActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:icon="@drawable/ic_browser"
            android:label="Arc7 Browser (TLS 1.3)"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- 3. Standalone Offline EPUB / TXT / HTML + 70,000-Book Free Store + Color .CBZ Comic Reader -->
        <activity
            android:name="ca.arc7freedom.app.Arc7EbookReaderActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:icon="@drawable/ic_ereader"
            android:label="Arc7 E-Reader">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.epub" />
                <data android:pathPattern=".*\\.cbz" />
                <data android:pathPattern=".*\\.txt" />
            </intent-filter>
        </activity>

        <!-- 4. Standalone Background Screen-Off Music & Audiobook Player (Auto-Bookmark + Sleep Timer) -->
        <activity
            android:name="ca.arc7freedom.app.Arc7AudioPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:icon="@drawable/ic_audio"
            android:label="Arc7 Audio">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\.flac" />
            </intent-filter>
        </activity>

        <!-- 5. Standalone Full Clock App: Alarms, Countdown Timers, Stopwatch, World Time & Nightstand -->
        <activity
            android:name="ca.arc7freedom.app.Arc7ClockActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:icon="@drawable/ic_clock"
            android:label="Arc7 Clock"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SET_ALARM" />
                <action android:name="android.intent.action.SET_TIMER" />
                <action android:name="android.intent.action.SHOW_ALARMS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Fullscreen Nightstand / Live TLS 1.3 Weather & Photo Dock (launched from Arc7 Clock & Tab 5) -->
        <activity
            android:name="ca.arc7freedom.app.Arc7DeskClockActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:icon="@drawable/ic_clock"
            android:label="Arc7 Nightstand Dock" />

        <!-- Fullscreen Lockscreen-Piercing Alarm & Countdown Timer Alert UI -->
        <activity
            android:name="ca.arc7freedom.app.Arc7AlarmAlertActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:label="Arc7 Alarm Alert" />

        <!-- 6. Standalone HD Wallpaper Studio (12 Built-In Art Themes + Custom MicroSD Photos + ACTION_SET_WALLPAPER) -->
        <activity
            android:name="ca.arc7freedom.app.Arc7WallpaperPickerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:icon="@drawable/ic_wallpaper"
            android:label="Arc7 Wallpapers">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SET_WALLPAPER" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- 7. Standalone Root App Manager, Bloatware Freezer & APK Backup Extractor -->
        <activity
            android:name="ca.arc7freedom.app.Arc7AppManagerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:icon="@drawable/ic_appmgr"
            android:label="Arc7 App Manager"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 8. Standalone Interactive Root (#) & Linux Shell Terminal -->
        <activity
            android:name="ca.arc7freedom.app.Arc7TerminalActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:icon="@drawable/ic_terminal"
            android:label="Arc7 Terminal"
            android:windowSoftInputMode="stateHidden|adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Background Services -->
        <service
            android:name="ca.arc7freedom.app.NightFilterService"
            android:exported="false" />
        <service
            android:name="ca.arc7freedom.app.Arc7WifiDriveService"
            android:exported="false" />
        <service
            android:name="ca.arc7freedom.app.SoftKeysOverlayService"
            android:exported="false" />
        <service
            android:name="ca.arc7freedom.app.Arc7AudioService"
            android:exported="false" />

        <!-- Scheduled Alarm & Countdown Timer Screen-Wake Receiver -->
        <receiver
            android:name="ca.arc7freedom.app.Arc7AlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="ca.arc7freedom.app.ACTION_ALARM_TRIGGER" />
                <action android:name="ca.arc7freedom.app.ACTION_TIMER_TRIGGER" />
            </intent-filter>
        </receiver>

        <!-- Automatic Reboot + Wi-Fi Connect NTP Clock Sync, Alarm Re-Arm & TLS 1.3 Gateway Self-Healer -->
        <receiver
            android:name="ca.arc7freedom.app.BootNetworkReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
